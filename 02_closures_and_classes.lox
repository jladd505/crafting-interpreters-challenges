// First-class functions, closures, classes, methods, and inheritance.
fun makeCounter(start) {
  var value = start;
  fun next() {
    value = value + 1;
    return value;
  }
  return next;
}

var counter = makeCounter(40);
print counter();
print counter();

class Greeter {
  init(name) { this.name = name; }
  greet() { return "Hello, " + this.name; }
}

class LoudGreeter < Greeter {
  greet() { return super.greet() + "!"; }
}

print LoudGreeter("Lox").greet();

