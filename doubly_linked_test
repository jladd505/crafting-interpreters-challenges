#include "doubly_linked_list.h"

#include <assert.h>
#include <stdio.h>
#include <string.h>

static void assert_links(const StringList *list) {
  size_t forward_count = 0;
  const ListNode *previous = NULL;
  for (const ListNode *node = list->head; node != NULL; node = node->next) {
    assert(node->previous == previous);
    previous = node;
    forward_count++;
  }
  assert(previous == list->tail);
  assert(forward_count == list->size);

  size_t backward_count = 0;
  const ListNode *next = NULL;
  for (const ListNode *node = list->tail; node != NULL; node = node->previous) {
    assert(node->next == next);
    next = node;
    backward_count++;
  }
  assert(next == list->head);
  assert(backward_count == list->size);
}

int main(void) {
  StringList list;
  list_init(&list);
  assert(list.size == 0 && list.head == NULL && list.tail == NULL);

  char mutable_text[] = "middle";
  assert(list_push_back(&list, mutable_text));
  mutable_text[0] = 'X';
  assert(strcmp(list.head->value, "middle") == 0);

  assert(list_push_front(&list, "first"));
  assert(list_push_back(&list, "last"));
  assert(list.size == 3);
  assert_links(&list);
  assert(list_find(&list, "middle") != NULL);
  assert(list_find(&list, "missing") == NULL);

  assert(list_delete(&list, "middle"));
  assert(list.size == 2);
  assert(strcmp(list.head->value, "first") == 0);
  assert(strcmp(list.tail->value, "last") == 0);
  assert_links(&list);

  assert(list_delete(&list, "first"));
  assert(list.head == list.tail);
  assert(list.head->previous == NULL && list.head->next == NULL);
  assert_links(&list);

  assert(list_delete(&list, "last"));
  assert(list.size == 0 && list.head == NULL && list.tail == NULL);
  assert(!list_delete(&list, "missing"));
  assert_links(&list);

  assert(list_push_back(&list, "reused"));
  list_clear(&list);
  assert(list.size == 0 && list.head == NULL && list.tail == NULL);

  puts("All doubly linked list tests passed.");
  return 0;
}
